{
  "name": "calculadora-imc",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.thomas.calculadoraimc",
    "productName": "Calculadora IMC",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "style.css",
      "build/icon.png",
      "package.json",
      {
        "from": "..",
        "to": ".",
        "filter": [
          "imc.js"
        ]
      }
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "installerLanguages": [
        "pt_BR"
      ],
      "language": "1046",
      "include": "build/installer.nsh"
    }
  },
  "description": "Calculadora de IMC para desktop (Electron)",
  "author": "Thomás Réa Farias"
}
